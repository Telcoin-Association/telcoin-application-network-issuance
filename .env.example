POLYGON_RPC_URL="xxx"
MAINNET_RPC_URL="xxx"
# TELCOIN_NETWORK_RPC_URL="xxx"
# Required by the Sepolia rehearsal, which is where the V3 staking stack currently lives
ETH_SEPOLIA_RPC_URL="xxx"

# Deploys. The deployer never owns anything it deploys: TANIssuanceHistory takes its owner as a
# constructor argument, so the Safe holds it from the first block.
PRIVATE_KEY="xxx"
ETHERSCAN_API_KEY="xxx"

# Safe that owns TANIssuanceHistory and the SimplePlugin. Every owner-gated action is proposed to it
# through script/safe/TANIssuanceSafeOps.s.sol.
DEPLOYER_SAFE_ADDRESS="0x..."
# Signers, numbered from zero. Add SIGNER_ADDRESS_1, _2, ... for each additional signer.
SIGNER_ADDRESS_0="0x..."
# Hardware wallet used to sign proposals: "ledger" (default) or "trezor". Only needed to propose,
# not to simulate.
HARDWARE_WALLET="ledger"
DERIVATION_PATH="m/44'/60'/0'/0/0"
